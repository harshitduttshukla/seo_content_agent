# Application
APP_ENV=local
ALLOW_LOCAL_AUTH=false
APP_NAME=seo-content-agent
API_PREFIX=/api/v1
LOG_LEVEL=INFO
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (async application URL and sync migration URL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/seo_content
DATABASE_MIGRATION_URL=postgresql+psycopg://postgres:postgres@localhost:5432/seo_content

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# OIDC authentication; do not commit local or production secrets
AUTH_ISSUER=https://identity.example.com/
AUTH_AUDIENCE=seo-content-api
AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json

# AI provider selected by deployment configuration
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Optional comma-separated models offered in the writer view (default: per-provider list)
AI_MODEL_OPTIONS=
# Optional per-provider keys: set both to pick Gemini or Claude models in the writer view
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_EMBEDDING_MODEL=

# S3-compatible object storage (AWS S3 or Cloudflare R2)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Google Search Console (read-only OAuth). Create an OAuth client in Google Cloud Console
# (Search Console API enabled) and register GSC_OAUTH_REDIRECT_URI as a redirect URI.
# GSC_TOKEN_ENCRYPTION_KEY is a Fernet key that encrypts stored refresh tokens:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
GSC_TOKEN_ENCRYPTION_KEY=
